# Docker Compose: copy to .env, then set your own random secret (32+ characters).
SECRET_KEY=replace-this-with-your-own-random-secret-at-least-32-characters
POSTGRES_PASSWORD=change-this-local-database-password
# Optional. Omit to use local rules with manual review.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
