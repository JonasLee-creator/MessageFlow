# Read explicitly with Node.js 20.6+: node --env-file=.env server.mjs
# competition: developer-provided API or personal API
# production: personal API only, enforced on the server
CHRONOFLOW_STAGE=competition
CHRONOFLOW_OFFICIAL_BASE_URL=https://api.deepseek.com
CHRONOFLOW_OFFICIAL_MODEL=
CHRONOFLOW_OFFICIAL_API_KEY=
# Required for the developer-provided API; choose a random value of 16+ characters.
CHRONOFLOW_OFFICIAL_ACCESS_CODE=
CHRONOFLOW_OFFICIAL_REQUESTS_PER_MINUTE=15
CHRONOFLOW_OFFICIAL_REQUESTS_PER_DAY=200
HOST=127.0.0.1
PORT=4173
